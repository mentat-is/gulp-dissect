[
    {
        "plugin": "evt",
        "mapping_parameters": {
            "mappings": {
                "dissect_evt": {
                    "fields": {
                        "ts": {
                            "ecs": [
                                "@timestamp"
                            ]
                        },
                        "EventCode": {
                            "ecs": [
                                "event.code"
                            ]
                        },
                        "hostname": {
                            "is_gulp_type": "context_name"
                        },
                        "SourceName": {
                            "is_gulp_type": "source_name"
                        },
                        "_source": {
                            "ecs": [
                                "log.file_path"
                            ]
                        }
                    }
                }
            },
            "mapping_id": "dissect_evt"
        }
    },
    {
        "plugin": "mft",
        "mapping_parameters": {
            "mapping_file": "/gulp/gulp-dissect/mapping_file_samples/dissect_mft.json",
            "mapping_id": "mft"
        }
    }
]