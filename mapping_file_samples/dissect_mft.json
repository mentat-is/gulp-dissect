{
    "metadata": {
        "plugin": [
            "gulp-dissect.py"
        ]
    },
    "mappings": {
        "default": {
            "exclude": [
                "_generated",
                "_version",
                "_source",
                "_classification"
            ],
            "fields": {
                "SourceFile": {
                    "ecs": [
                        "file.path"
                    ]
                }
            },
            "agent_type": "ds-mft",
            "event_code": "default"
        },
        "mft": {
            "fields": {
                "ts": {
                    "ecs": [
                        "@timestamp"
                    ]
                },
                "filesize": {
                    "ecs": [
                        "file.size"
                    ]
                },
                "hostname": {
                    "is_gulp_type": "context_name"
                },
                "path": {
                    "is_gulp_type": "source_name"
                },
                "_source": {
                    "ecs": [
                        "log.file_path"
                    ]
                }
            },
            "agent_type": "ds-mft",
            "event_code": "dissect_mft"
        }
    }
}